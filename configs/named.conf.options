options {
    directory "/var/cache/bind";
    recursion yes;
    allow-query { 192.168.0.0/24; };
    forwarders {
        1.1.1.1;
        8.8.8.8;
    };
    dnssec-validation auto;
    listen-on { 192.168.0.110; };
};

logging {
    channel query.log {
        file "/var/log/named/query.log";
        print-time yes;
        severity debug;
    };
    category queries { query.log; };
};
